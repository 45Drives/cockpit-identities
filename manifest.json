        "rocky": "noarch"
    },
    "description": "User and Group Management for Cockpit (Houston)",
    "defaults": {
        "change_urgency": "medium"
    },
    "dependencies": {
        "ubuntu_common": [
            "cockpit",
            "bash",
            "coreutils",
            "hostname",
            "libc-bin",
            "passwd",
            "psmisc",
            "samba",
            "samba-common-bin",
            "sudo",
            "util-linux",
            "perl",
            "openssh-client"
        ],
        "rocky_common": [
            "cockpit",
            "bash",
            "coreutils",
            "glibc-common",
            "hostname",
            "passwd",
            "psmisc",
            "samba-common-tools",
            "shadow-utils",
            "sudo",
            "util-linux",
            "util-linux-user",
            "perl",
            "openssh"
        ]
    },
    "builds": [
        {
            "image": "ci.cr.45d.io/ci/simple/ubuntu-focal:1",
            "os_name": "ubuntu-focal",
            "group": "ubuntu"
        },
        {
            "image": "ci.cr.45d.io/ci/simple/ubuntu-jammy:1",
            "os_name": "ubuntu-jammy",
            "group": "ubuntu"
        },
        {
            "group": "debian",
            "os_name": "debian-bookworm",
            "image": "ci.cr.45d.io/ci/simple/debian-bookworm:1"
        },
        {
            "group": "debian",
            "os_name": "debian-trixie",
            "image": "ci.cr.45d.io/ci/simple/debian-trixie:1"
        },
        {
            "image": "ci.cr.45d.io/ci/simple/rocky-el8:1",
            "os_name": "rocky-el8",
            "group": "rocky"
        },
        {
            "image": "ci.cr.45d.io/ci/simple/rocky-el9:1",
            "os_name": "rocky-el9",
            "group": "rocky"
        }
    ],
    "repos": [
        "community",
        "enterprise"
    ],
    "changelog": {
        "urgency": "medium",
        "version": "0.1.12",
        "build_number": "3",
        "date": null,
        "packager": "Joshua Boudreau <jboudreau@45drives.com>",
