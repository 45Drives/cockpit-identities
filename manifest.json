{
    "schema_version": "45D_AP_V2.0",
    "name": "cockpit-identities",
    "title": "Cockpit Identities",
    "stable": true,
    "version": "0.1.12",
    "build_number": "3",
    "author": "Joshua Boudreau <jboudreau@45drives.com>",
    "git_url": "https://github.com/45Drives/cockpit-identities",
    "license": "GPL-3.0+",
    "architecture": {
